<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Game.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\razlom\Assets\Game.Sim\**\*.cs" Link="Game.Sim\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\razlom\Assets\Game.Tests\**\*.cs" Link="Game.Tests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

