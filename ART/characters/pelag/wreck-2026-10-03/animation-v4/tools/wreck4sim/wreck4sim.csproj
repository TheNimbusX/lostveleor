<Project Sdk="Microsoft.NET.Sdk">
  <!-- Крушение v4 (06.10): голова якоря по серии Wreck4 — ТЕ ЖЕ файлы физики, что игра и anchorbake
       (AnchorRigCore.StepLive, AnchorRigBody, AnchorHeadDynamics), только проигрыватель серии свой: несколько клипов подряд,
       ход и поворот корня, короткая цепь в махах, бросок с выдачей цепи на выпаде, рывок обратно.
       Сборка: dotnet build wreck4sim.csproj -artifacts-path ../obj-w4 (своя папка артефактов). Код razlom/ только читается. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Wreck4Sim</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <Core>../../../../../../../artifacts/anchor-core</Core>
    <View>../../../../../../../razlom/Assets/Game.View</View>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(View)/AnchorHeadDynamics.cs" Link="View/AnchorHeadDynamics.cs" />
    <Compile Include="$(View)/AnchorChainSolver.cs" Link="View/AnchorChainSolver.cs" />
    <Compile Include="$(Core)/drafts/razlom/Assets/Game.View/AnchorRigBlend.cs" Link="Rig/AnchorRigBlend.cs" />
    <Compile Include="$(Core)/drafts/razlom/Assets/Game.View/AnchorRigCore.cs" Link="Rig/AnchorRigCore.cs" />
    <Compile Include="$(Core)/drafts/razlom/Assets/Game.View/AnchorRigBody.cs" Link="Rig/AnchorRigBody.cs" />
    <Compile Include="$(Core)/bake/anchorbake/GripTrack.cs" Link="Bake/GripTrack.cs" />
    <Compile Include="$(Core)/bake/anchorbake/HeadModel.cs" Link="Bake/HeadModel.cs" />
  </ItemGroup>
</Project>
