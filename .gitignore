# Unity generated state
/razlom/[Ll]ibrary/
/razlom/[Tt]emp/
/razlom/[Oo]bj/
/razlom/[Ll]ogs/
/razlom/[Uu]ser[Ss]ettings/
/razlom/[Mm]emoryCaptures/
/razlom/[Rr]ecordings/
/razlom/.vs/
/razlom/*.csproj
/razlom/*.sln
/razlom/*.user

# Generated test/build output
/artifacts/
**/bin/
**/obj/
TestResults/

# Local hidden workspace state
/.*/
!/.gitignore
!/.gitattributes

# Obsolete prototype/tool mirror plus downloaded 3D tooling. Deleted 30 Aug 2026;
# the rule stays so a stray re-download never lands in history.
/code/

# Generated delivery bundles; their source assets and generation scripts are versioned separately.
/ART/designed-images/deliverables/

# Local source packages are already imported into the live Unity project.
/ART/packs/

# РљРѕРЅС‚СЂРѕР»СЊРЅС‹Рµ СЂРµРЅРґРµСЂС‹ Рё СЃРЅРёРјРєРё РїСЂРѕРІРµСЂРѕРє. РџРµСЂРµСЃРѕР·РґР°СЋС‚СЃСЏ СЃРєСЂРёРїС‚Р°РјРё, С‡РёСЃС‚СЏС‚СЃСЏ РІСЂСѓС‡РЅСѓСЋ.
/ART/renders/

# Blender/Python transient files
*.blend1
**/__pycache__/
*.py[cod]
.pytest_cache/

# Аварийная папка Unity: редактор кладёт сюда копию сцены после падения.
# Восстанавливать из неё можно, версионировать — нет: это снимок аварии,
# а не состояние проекта.
/razlom/Assets/_Recovery/
/razlom/Assets/_Recovery.meta

# Промежуточные выгрузки из Tripo/AccuRig: игрой не используются, живут на диске.
**/character-only.fbx
**/character-only.json

# IDE and OS noise
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
Desktop.ini

# Working files for character generation (Tripo/Mixamo intermediates).
# The editable .blend and source art live in ART/; everything here is scratch
# and must never reach a teammate as a multi-megabyte download.
/characters/

# Regenerated by the runtime validator on every run; a report, not a source.
/razlom/pelag_v5_validation.json
